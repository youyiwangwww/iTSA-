#include <iostream>
#include <string>
using namespace std;

struct Dictionary {
    string english;
    string chinese;
};

int main() {
    Dictionary dict[] = {
        {"dog", "狗"},
        {"cat", "貓"},
        {"duck", "鴨"},
        {"cow", "牛"},
        {"fox", "狐"}
    };

    int num_items = sizeof(dict) / sizeof(dict[0]);
    string input;

    if (cin >> input) {
        for (int i = 0; i < num_items; i++) {
            // 輸入英文，輸出中文
            if (input == dict[i].english) {
                cout << dict[i].chinese << endl;
                break;
            }
            // 輸入中文，輸出英文
            else if (input == dict[i].chinese) {
                cout << dict[i].english << endl;
                break;
            }
        }
    }

    return 0;
}
