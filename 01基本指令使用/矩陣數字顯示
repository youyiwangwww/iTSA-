#include <iostream>
#include <string>
using namespace std;

int main() {
    int num;

    if (!(cin >> num)) {
        return 0;
    }

    string patterns[10][5] = {
        {"*****", "*   *", "*   *", "*   *", "*****"}, // 0
        {"    *", "    *", "    *", "    *", "    *"}, // 1
        {"*****", "    *", "*****", "*   *", "*****"}, // 0
        {"    *", "    *", "    *", "    *", "   ", "*    ", "*****"}, // 2
        {"*****", "    *", "*****", "    *", "*****"}, // 3
        {"*   *", "*   *", "*****", "    *", "    *"}, // 4
        {"*****", "*    ", "*****", "    *", "*****"}, // 5
        {"*****", "*    ", "*****", "*   *", "*****"}, // 6
        {"*****", "    *", "    *", "    *", "    *"}, // 7
        {"*****", "*   *", "*****", "*   *", "*****"}, // 8
        {"*****", "*   *", "*****", "    *", "*****"}  // 9
    };

    if (num >= 0 && num <= 9) {
        for (int i = 0; i < 5; i++) {
            cout << patterns[num][i] << '\n';
        }
    }

    return 0;
}
