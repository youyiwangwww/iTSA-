#include <iostream>
using namespace std;

int main() {
    int type;

    if (!(cin >> type)) {
        return 0;
    }

    // 空心三角形
    if (type == 1) {
        for (int i = 1; i <= 5; i++) {
            for (int j = 1; j <= 5 - i; j++) {
                cout << " ";
            }

            if (i == 1) {
                cout << "*\n";
            } 
            else if (i == 5) {
                for (int j = 1; j <= 9; j++) {
                    cout << "*";
                }
                cout << '\n';
            } 
            else {
                cout << "*";  // 左邊界

                for (int j = 1; j <= 2 * i - 3; j++) {
                    cout << " ";
                }

                cout << "*\n"; // 右邊界
            }
        }
    } 
    // 實心三角形
    else if (type == 2) {
        for (int i = 1; i <= 5; i++) {
            for (int j = 1; j <= 5 - i; j++) {
                cout << " ";
            }

            for (int j = 1; j <= 2 * i - 1; j++) {
                cout << "*";
            }

            cout << '\n';
        }
    } 
    // 實心倒三角形
    else if (type == 3) {
        for (int i = 1; i <= 5; i++) {
            for (int j = 1; j <= i - 1; j++) {
                cout << " ";
            }

            for (int j = 1; j <= 2 * (6 - i) - 1; j++) {
                cout << "*";
            }

            cout << '\n';
        }
    }

    return 0;
}
