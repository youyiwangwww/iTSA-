#include <iostream>
using namespace std;

int main() {
    int num;

    while (cin >> num) {
        int thousands = num / 1000;
        int hundreds = (num / 100) % 10;
        int tens = (num / 10) % 10;
        int ones = num % 10;

        // 注意逗號
        cout << ones << ","
             << tens << ","
             << hundreds << ","
             << thousands << '\n';
    }

    return 0;
}
