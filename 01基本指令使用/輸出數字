#include <iostream>
using namespace std;

int main() {
    int num;

    while (cin >> num) {
        int thousands = num / 1000;          // 2314 / 1000 = 2
        int hundreds = (num / 100) % 10;     // 2314 / 100 = 23，23 % 10 = 3
        int tens = (num / 10) % 10;
        int ones = num % 10;

        cout << thousands << '\n';
        cout << hundreds << '\n';
        cout << tens << '\n';
        cout << ones << '\n';
    }

    return 0;
}
