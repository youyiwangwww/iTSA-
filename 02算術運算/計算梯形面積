#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    int T, B, H;
    double area;

    while (cin >> T >> B >> H) {
        // 除以 2.0，確保使用浮點數運算
        area = static_cast<double>(T + B) * H / 2.0;

        cout << fixed << setprecision(1);
        cout << "Trapezoid area:" << area << '\n';
    }

    return 0;
}
