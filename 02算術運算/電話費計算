#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    int m;
    double cost;

    cin >> m;

    cost = m * 0.9;

    // 折扣判斷
    if (m <= 800) {
        // 不再額外打折
    }
    else if (m < 1500) {
        cost *= 0.9;
    }
    else {
        cost *= 0.79;
    }

    cout << fixed << setprecision(1) << cost << '\n';

    return 0;
}
