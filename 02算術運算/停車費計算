#include <iostream>
using namespace std;

int main() {
    int se, sm, eh, em;
    int start, end, totalMin;
    int unit;
    int cost = 0;

    cin >> se >> sm;
    cin >> eh >> em;

    // 將開始時間與結束時間轉換成分鐘
    start = se * 60 + sm;
    end = eh * 60 + em;

    // 計算總停車分鐘數
    totalMin = end - start;

    // 每 30 分鐘為一個計費單位
    unit = totalMin / 30;

    if (unit <= 4) {
        cost = unit * 30;
    }
    else if (unit <= 8) {
        cost = 4 * 30 + (unit - 4) * 40;
    }
    else {
        cost = 4 * 30 + 4 * 40 + (unit - 8) * 60;
    }

    cout << cost << '\n';

    return 0;
}
