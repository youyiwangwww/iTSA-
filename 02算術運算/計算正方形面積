#include <iostream>
#include <iomanip>
#include <cmath>
using namespace std;

int main() {
    int n;
    double w, area;

    if (cin >> n) {
        for (int i = 0; i < n; i++) {
            if (cin >> w) {
                area = w * w;

                // 四捨五入到小數點後一位
                area = floor(area * 10 + 0.5) / 10.0;

                cout << fixed << setprecision(1) << area << '\n';
            }
        }
    }

    return 0;
}
