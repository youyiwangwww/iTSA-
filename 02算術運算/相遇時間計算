#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int m;
    double mySpeed = 1.0;
    double friendSpeed = 30 * 2.54 / 100.0;  // 英吋轉公尺
    double relativeSpeed;
    double time;

    cin >> m;

    // 計算相對速度
    relativeSpeed = mySpeed - friendSpeed;

    // 計算追上朋友所需的時間
    time = m / relativeSpeed;

    // ceil() 無條件進位
    cout << static_cast<int>(ceil(time)) << '\n';

    return 0;
}
