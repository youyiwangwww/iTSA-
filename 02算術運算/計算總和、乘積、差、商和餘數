#include <iostream>
using namespace std;

int main() {
    int x, y;

    while (cin >> x >> y) {
        int quotient = x / y;
        int remainder = x % y;

        // 確保餘數大於或等於 0
        if (remainder < 0) {
            if (y > 0) {
                remainder += y;
                quotient -= 1;
            }
            else {
                remainder -= y;
                quotient += 1;
            }
        }

        cout << x << "+" << y << "=" << x + y << '\n';
        cout << x << "*" << y << "=" << x * y << '\n';
        cout << x << "-" << y << "=" << x - y << '\n';
        cout << x << "/" << y << "="
             << quotient << "..." << remainder << '\n';
    }

    return 0;
}
