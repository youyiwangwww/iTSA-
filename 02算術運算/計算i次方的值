#include <iostream>
using namespace std;

int main() {
    int n;
    int i;

    cin >> n;

    for (int k = 0; k < n; k++) {
        cin >> i;

        if (i > 31) {
            cout << "Value of more than 31\n";
        } else {
            // 計算 2 的 i 次方
            unsigned int result = 1U << i;
            cout << result << '\n';
        }
    }

    return 0;
}
