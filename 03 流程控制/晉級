#include <iostream>
#include <string>
using namespace std;

int main() {
    int n, score;
    int pass = 0;
    string name;

    cin >> n;

    for (int i = 0; i < n; i++) {
        cin >> name >> score;

        if (score >= 60) {
            cout << name << '\n';
            pass++;
        }
    }

    if (pass * 2 >= n) {
        cout << "晉級\n";
    }
    else {
        cout << "失敗\n";
    }

    return 0;
}
